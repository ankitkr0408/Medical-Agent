# HealthIQ — Environment Variables Template
# Copy this to .env.local for local dev, then add to Vercel dashboard for production.
# ⚠️  NEVER commit your actual .env file to git.

# ============================================================
# TIER 1 — REQUIRED (app will not start without these)
# ============================================================

# MongoDB Atlas — free M0 cluster works fine
# Create at: https://cloud.mongodb.com  →  Free tier  →  copy connection string
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/healthiq?retryWrites=true&w=majority"

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"

# OpenAI — powers image analysis (gpt-4o), specialist opinions, QA (gpt-4o-mini), embeddings
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-..."

# App URL — must match your domain exactly (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ============================================================
# TIER 2 — RECOMMENDED (free, unlocks faster RAG)
# ============================================================

# Pinecone vector DB — replaces slow in-memory cosine similarity for Q&A
# Free tier: 1 index, 100k vectors, 2GB storage  →  https://pinecone.io
# Step 1: Create account  →  Create index: dimension=1536, metric=cosine, cloud=aws, region=us-east-1
# Step 2: Copy API key below, set index name (default: healthiq-rag)
# PINECONE_API_KEY="pcsk_..."
# PINECONE_INDEX="healthiq-rag"

# ============================================================
# TIER 3 — OPTIONAL (nice to have)
# ============================================================

# Google OAuth — enables "Sign in with Google"
# Create at: https://console.cloud.google.com  →  APIs & Services  →  Credentials
# GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-..."

# AWS S3 — for persistent image storage (currently images are base64 in-request)
# Free tier: 5GB storage, 20k GET, 2k PUT requests/month
# AWS_ACCESS_KEY_ID="AKIA..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_REGION="us-east-1"
# AWS_BUCKET_NAME="healthiq-images"

# ============================================================
# AUTO-SET by Vercel — do NOT add manually in production
# ============================================================
# NEXTAUTH_URL  →  set to your deployment URL automatically
# NODE_ENV      →  set to "production" automatically
# VERCEL        →  set to "1" automatically
